# Copy to .env.local and fill in your own values. NEVER commit .env.local.
# No token or key belongs in this file or in code.

# Messenger Leads reply webhook (optional).
# A separate send endpoint (e.g. an n8n workflow) that accepts
# { businessId, pageId, recipientPsid, message } and sends it via the
# Facebook Graph API using that business's Page token, stored server-side.
# Leave empty for local-only replies (saved in-thread, marked Pending send).
# Do NOT use the bot's inbound webhook (…/webhook/automateiq-messenger) here.
# Full request/response contract: see MESSENGER_REPLY_SPEC.md.
VITE_MESSENGER_REPLY_WEBHOOK_URL=

# Existing Gemini key for the public AI assistant (unchanged, see README).
GEMINI_API_KEY=
